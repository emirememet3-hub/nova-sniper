rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{entryId} {
      // Herkes liderlik tablosunu okuyabilir.
      allow read: if true;

      // Yalnızca oturum açmış kullanıcı kendi UID'siyle yeni skor ekleyebilir.
      // Kayıtlar sonradan değiştirilemez veya silinemez.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'wave', 'at', 'cheated'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cheated == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1
        && request.resource.data.wave <= 10000
        && request.resource.data.at is int;

      allow update, delete: if false;
    }

    // Diğer tüm koleksiyonlar varsayılan olarak kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
